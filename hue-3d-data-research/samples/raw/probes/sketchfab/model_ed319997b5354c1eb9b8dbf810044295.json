/\/media.sketchfab.com\/avatars\/7f8962692c2d4e9a98885e48ea57c318\/cfd93f73a53648d49f405a67936c4202.jpeg"},{"width":100,"height":100,"size":3265,"url":"https:\/\/media.sketchfab.com\/avatars\/7f8962692c2d4e9a98885e48ea57c318\/bdf26cc68bf2408b99f699070c4771ea.jpeg"}]},"uri":"https:\/\/api.sketchfab.com\/v3\/users\/5d2af027c6d248d6a73ed4f92ba1ca7e"},"vertexCount":1254247,"viewCount":5288,"viewerUrl":"https:\/\/sketchfab.com\/3d-models\/hoa-khiem-temple-tomb-of-emperor-tu-duc-ed319997b5354c1eb9b8dbf810044295","isDownloadable":false,"isProtected":false,"description":"The Complex of Hu\u00e9 Monuments is located within the Thua Thien-Hue Province in the geographical center of Vietnam. Established as the capital of unified Vietnam in 1802, Hue was not only the political but also the cultural and religious center under the Nguyen dynasty until 1945. The Hu\u00e9 Monuments Complex has suffered from the effects of wars, as well as modern development and expanding human settlements. The Tu Duc Tomb is the final resting place of Emperor Tu Duc who reigned from 1848 until his death in 1883. Tu Duc faced encroaching colonialism from the west as well as turmoil within the Vietnam, particularly related to the construction of his tomb. In attempt reduce the construction time, managers of the project reduced the timeline from six to three years by eliminating laborers' breaks, resulting in a rebellion. After a short delay, construction resumed, culminating in a park-like tomb complex designed to reflect Tu Duc\u2019s extensive education in history, philosophy, literature, and art.","price":null,"downloadCount":1,"editorUrl":"https:\/\/sketchfab.com\/models\/ed319997b5354c1eb9b8dbf810044295\/edit","status":{"warning":{},"processing":"SUCCEEDED"},"source":"website","hasCommentsDisabled":false,"updatedAt":"2022-06-04T10:58:39.936958","pbrType":null,"textureCount":20,"materialCount":20}